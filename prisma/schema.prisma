// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // This will be your Supabase connection string
}

model Business {
  id              String   @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  // Relation to employees, services, etc.
  employees       Employee[]
  services        Service[]
  timeBlocks      TimeBlock[]
  // Auth relationship
  userId          String   @unique // Links to Supabase Auth user
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  // Many-to-Many relationship with Service
  services  Service[] @relation("EmployeeServices")
  business  Business @relation(fields: [businessId], references: [id])
  businessId String
  // Employee's working hours
  workingHours WorkingHours[]
  // Appointments they are assigned to
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int // Duration in minutes
  price       Float?
  imageUrl    String?
  // Many-to-Many relationship with Employee
  employees   Employee[] @relation("EmployeeServices")
  business    Business  @relation(fields: [businessId], references: [id])
  businessId  String
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id         String   @id @default(cuid())
  startTime  DateTime
  endTime    DateTime
  clientName String
  clientEmail String
  clientPhone String?
  notes      String?
  status     String   @default("confirmed") // confirmed, cancelled, completed

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorkingHours {
    id        String @id @default(cuid())
    employee  Employee @relation(fields: [employeeId], references: [id])
    employeeId String
    // 0 = Sunday, 1 = Monday, etc.
    dayOfWeek Int
    startTime String // e.g., "09:00"
    endTime   String   // e.g., "17:00"
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TimeBlock {
    id          String   @id @default(cuid())
    startTime   DateTime // Start of the blocked period
    endTime     DateTime // End of the blocked period
    reason      String?
    // Optional: link to a specific employee if it's a personal block
    employee    Employee? @relation(fields: [employeeId], references: [id])
    employeeId  String?
    // Belongs to the business
    business    Business @relation(fields: [businessId], references: [id])
    businessId  String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}